# The desktop on the installed system: Hyprland on the boot framebuffer.
#
# There is no GPU driver for the M4 yet, so Hyprland draws with Mesa's
# llvmpipe on the CPU into simpledrm (the framebuffer iBoot set up, which m1n1
# describes), at 3024x1964 and scale 2. Blur, shadows and animations start
# off because they cost the most in software; turn them on in
# ~/.config/hypr/hyprland.conf if they are smooth enough.
#
# Log in on the screen (greetd/tuigreet); it starts Hyprland. The first
# login copies /etc/hypr/hyprland.lua (nixos/hyprland.lua) to
# ~/.config/hypr/, which is then yours.
{ config, lib, pkgs, ... }:

let
  # Seed the user's config once, then start Hyprland through its launcher.
  # Hyprland's own autogenerated config (from a login before this one
  # existed) counts as missing.
  startHyprland = pkgs.writeShellScript "start-hyprland-m4pro" ''
    conf="$HOME/.config/hypr/hyprland.lua"
    if [ ! -e "$conf" ] || grep -q 'autogenerated = true' "$conf"; then
      mkdir -p "$HOME/.config/hypr"
      install -m 644 /etc/hypr/hyprland.lua "$conf"
    fi
    exec start-hyprland
  '';
in
{
  programs.hyprland.enable = true;
  # Mesa: llvmpipe for OpenGL ES and GBM on simpledrm.
  hardware.graphics.enable = true;

  environment.etc."hypr/hyprland.lua".source = ./hyprland.lua;

  # aquamarine (Hyprland's backend) finds no EGL device for simpledrm, which
  # has no render node, and retries on every commit. Its unmerged PR #406
  # falls back to the GBM platform, where llvmpipe works.
  nixpkgs.overlays = [
    (final: prev: {
      aquamarine = prev.aquamarine.overrideAttrs (old: {
        patches = (old.patches or [ ]) ++ [
          ../aquamarine/patches/0001-drm-fall-back-to-the-GBM-platform.patch
        ];
      });
    })
  ];
  # foot's default font, readable at scale 2 (override in ~/.config/foot).
  environment.etc."xdg/foot/foot.ini".text = ''
    [main]
    font=monospace:size=13
  '';

  services.greetd = {
    enable = true;
    settings.default_session = {
      command = "${pkgs.tuigreet}/bin/tuigreet --time --remember --asterisks --cmd ${startHyprland}";
      user = "greeter";
    };
  };

  environment.systemPackages = with pkgs; [
    foot
    fuzzel
    waybar
    firefox
    brightnessctl
    pavucontrol
  ];

  fonts.packages = with pkgs; [
    noto-fonts
    noto-fonts-color-emoji
    font-awesome
    dejavu_fonts
  ];

  # Updates over the network once Wi-Fi is up: key-only SSH. Add your public
  # key to ~/.ssh/authorized_keys on the Mac.
  services.openssh = {
    enable = true;
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "no";
    };
  };
}
