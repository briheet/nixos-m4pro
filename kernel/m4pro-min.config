# Minimal bring-up kernel for J614s, on top of allnoconfig.
# Only what this Mac needs, so the tethered upload is short.
#   make ARCH=arm64 O=/src/build-min allnoconfig
#   scripts/kconfig/merge_config.sh -m -O /src/build-min /src/build-min/.config kernel/m4pro-min.config
CONFIG_LOCALVERSION="-m4pro-min"
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT=y
CONFIG_KERNEL_GZIP=y

# Core userspace support for BusyBox and, later, systemd.
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AIO=y
CONFIG_FILE_LOCKING=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_UNIX98_PTYS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y

# Debugging the bring-up.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEVMEM=y

# Platform: interrupts, consoles, power domains, pins, buses, watchdog.
CONFIG_OF=y
CONFIG_APPLE_AIC=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_MFD_SYSCON=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_GPIOLIB=y
CONFIG_I2C=y
CONFIG_I2C_APPLE=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_WATCHDOG=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_PWM=y
CONFIG_PWM_APPLE=y

# Screen: m1n1's framebuffer.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y

# Storage path for later items (NVMe behind ANS and the SART).
CONFIG_BLOCK=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y

# Internal keyboard and trackpad: MTP coprocessor (RTKit helper), its
# mailbox and DART, the dockchannel FIFO, and HID over it.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_HID_APPLE=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_FW_LOADER=y
