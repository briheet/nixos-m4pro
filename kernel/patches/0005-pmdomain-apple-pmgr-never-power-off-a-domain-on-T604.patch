From 50670ad4c90e34a370a06ee66135de07556ca968 Mon Sep 17 00:00:00 2001
From: nixos-m4pro <local@local>
Date: Thu, 12 Nov 2026 20:14:38 +0000
Subject: [PATCH 5/7] pmdomain: apple: pmgr: never power off a domain on T6040
 (bring-up)

genpd sync_state powers off domains it considers unused, which
pd_ignore_unused does not stop. On the M4 Pro (J614s) a minimal kernel
then took an SError on the next PMGR read in apple_pmgr_ps_set (from
of_genpd_sync_state, 0.095 s after boot), and a fuller kernel reset the
machine on its own a few minutes after boot. Leave every domain as the
firmware left it on apple,t6040; genpd still records it as off.
---
 drivers/pmdomain/apple/pmgr-pwrstate.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index 4cebef602..cb9dcda7b 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -147,6 +147,16 @@ static int apple_pmgr_ps_power_on(struct generic_pm_domain *genpd)
 
 static int apple_pmgr_ps_power_off(struct generic_pm_domain *genpd)
 {
+	/*
+	 * T6040 (M4 Pro) bring-up: never gate a domain. genpd sync_state gates
+	 * domains it sees as unused even with pd_ignore_unused. On J614s the
+	 * next PMGR read then raised an SError (minimal kernel, 0.095 s), and
+	 * with more drivers bound the machine reset itself a few minutes in.
+	 * genpd records the domain as off; the hardware keeps the firmware state.
+	 */
+	if (of_machine_is_compatible("apple,t6040"))
+		return 0;
+
 	return apple_pmgr_ps_set(genpd, APPLE_PMGR_PS_PWRGATE, false);
 }
 
