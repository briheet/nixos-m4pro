From 79db0bc5ef0cc681b38165ce73add1b65b0e4a6a Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 10:18:35 +0000
Subject: [PATCH 23/23] arm64: dts: apple: t6041: Add an empty reserved-memory
 node

m1n1 adds its carveouts to /reserved-memory and U-Boot the RTKit buffers of
the coprocessors it hands on running; both expect the node to exist.
---
 arch/arm64/boot/dts/apple/t6041.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
index 7b6a56a5b..d39c7a024 100644
--- a/arch/arm64/boot/dts/apple/t6041.dtsi
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -18,6 +18,16 @@ aliases {
 		pmp = &pmp;
 	};
 
+	/*
+	 * Filled by the boot loaders: m1n1 adds its carveouts here and U-Boot
+	 * the RTKit buffers of coprocessors it hands on running.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+	};
+
 	clkref: clock-ref {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
-- 
2.47.0

