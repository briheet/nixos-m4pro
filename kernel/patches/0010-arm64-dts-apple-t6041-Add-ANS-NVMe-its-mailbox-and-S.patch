From 65702363f35b8142abca9cadabe9f57f86cc21c1 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Thu, 12 Nov 2026 23:29:15 +0000
Subject: [PATCH 10/11] arm64: dts: apple: t6041: Add ANS NVMe, its mailbox and
 SART

---
 arch/arm64/boot/dts/apple/t6041.dtsi | 49 ++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
index 07ab1d4be..9b124c510 100644
--- a/arch/arm64/boot/dts/apple/t6041.dtsi
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -657,6 +657,55 @@ mtp_hid: input@8000 {
 			};
 		};
 
+		/*
+		 * ANS, the coprocessor in front of the internal SSD, its mailbox
+		 * and the SART that limits its DMA. Addresses and interrupts are
+		 * from the J614s Apple device tree (/arm-io/ans: reg 0 ASC,
+		 * reg 9 NVMe; /arm-io/sart-ans reg 0; interrupts 1530-1533 for
+		 * the mailbox and 2583 for NVMe), laid out as in t6031-nvme.dtsi.
+		 *
+		 * Like other M4-generation ANS (the ADT has nvme-secure-bar), the
+		 * controller is driven through reg 9: reg 3 mirrors only part of
+		 * it, and the linear SQ and NVMMU registers fault there (m1n1
+		 * 543667fe "nvme: use reg[9] for everything on T8132"). The ADT
+		 * gives reg 9 as 0x10000 long, but the driver reaches the NVMMU at
+		 * 0x28100, so 0x40000 is mapped as on earlier SoCs.
+		 */
+		ans_mbox: mbox@409608000 {
+			compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x4 0x09608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1530 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1531 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1532 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1533 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			power-domains = <&ps_ans>;
+			#mbox-cells = <0>;
+		};
+
+		sart: sart@40dc50000 {
+			compatible = "apple,t6041-sart", "apple,t6000-sart";
+			reg = <0x4 0x0dc50000 0x0 0xc000>;
+			power-domains = <&ps_ans>;
+		};
+
+		nvme: nvme@44dcc0000 {
+			compatible = "apple,t6041-nvme-ans2", "apple,t8132-nvme-ans2";
+			reg = <0x4 0x4dcc0000 0x0 0x40000>,
+			      <0x4 0x09600000 0x0 0x4000>;
+			reg-names = "nvme", "ans";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 2583 IRQ_TYPE_LEVEL_HIGH>;
+			mboxes = <&ans_mbox>;
+			apple,sart = <&sart>;
+			power-domains = <&ps_ans>, <&ps_apcie_sys_st0>,
+					<&ps_apcie_sys_st1>;
+			power-domain-names = "ans", "apcie0", "apcie1";
+			resets = <&ps_ans>;
+		};
+
 		wdt: watchdog@50836c000 {
 			compatible = "apple,t6041-wdt", "apple,t8103-wdt";
 			reg = <0x5 0x0836c000 0x0 0x4000>;
