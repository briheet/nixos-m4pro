From 7a426d5d26bdd2ccb860be81797b717096c55cf2 Mon Sep 17 00:00:00 2001
From: nixos-m4pro <local@local>
Date: Thu, 12 Nov 2026 21:35:23 +0000
Subject: [PATCH 08/11] arm64: dts: apple: j614s: Leave the GPU PMGR domains
 out

Powering on afr in the GPU PMGR block at probe raised an SError. Leave
gpx, afr and gfx undescribed until there is a GPU driver, as Asahi's
t8132, t6031 and t8122 trees do.
---
 .../boot/dts/apple/t6040-j614s-pmgr.dtsi      | 29 -------------------
 1 file changed, 29 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi b/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi
index b44970154..77fbc7135 100644
--- a/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi
@@ -5,35 +5,6 @@
  * (/arm-io/pmgr devices and ps-regs). Do not edit by hand.
  */
 
-&pmgr_gfx {
-	ps_gpx: power-controller@0 {
-		compatible = "apple,t6040-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
-		reg = <0 4>;
-		label = "gpx";
-		#power-domain-cells = <0>;
-		#reset-cells = <0>;
-		apple,always-on;
-	};
-
-	ps_afr: power-controller@100 {
-		compatible = "apple,t6040-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
-		reg = <0x100 4>;
-		label = "afr";
-		#power-domain-cells = <0>;
-		#reset-cells = <0>;
-		apple,always-on;
-	};
-
-	ps_gfx: power-controller@110 {
-		compatible = "apple,t6040-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
-		reg = <0x110 4>;
-		label = "gfx";
-		#power-domain-cells = <0>;
-		power-domains = <&ps_afr>;
-		#reset-cells = <0>;
-	};
-};
-
 &pmgr {
 	ps_ispsens0: power-controller@0 {
 		compatible = "apple,t6040-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
