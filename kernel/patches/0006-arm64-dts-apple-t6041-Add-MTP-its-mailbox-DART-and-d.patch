From df138647eb0e3d079c49cad3ce8a7f3db775358d Mon Sep 17 00:00:00 2001
From: nixos-m4pro <local@local>
Date: Thu, 12 Nov 2026 20:22:28 +0000
Subject: [PATCH 6/8] arm64: dts: apple: t6041: Add MTP, its mailbox, DART and
 dockchannel

The internal keyboard and trackpad on M4 Pro/Max laptops sit behind the
MTP coprocessor and a dockchannel FIFO, as on t602x. Addresses and
interrupts are taken from the J614s Apple device tree. The DART registers
are at the start of dart-mtp reg 0 (PARAMS4 reports 16 SIDs there and
PARAMS3 42-bit PA/VA, v2.2); on t602x they are 0x8000 in. The ADT lists
no PMGR domain for MTP.
---
 arch/arm64/boot/dts/apple/t6041.dtsi | 82 ++++++++++++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
index cf7b1cc05..07ab1d4be 100644
--- a/arch/arm64/boot/dts/apple/t6041.dtsi
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -575,6 +575,88 @@ pmgr_mini: power-management@508300000 {
 			#size-cells = <1>;
 		};
 
+		/*
+		 * MTP: the coprocessor behind the internal keyboard and trackpad,
+		 * its mailbox and DART, and the dockchannel FIFO HID runs over.
+		 * Addresses and interrupts are from the J614s Apple device tree
+		 * (/arm-io/mtp, /arm-io/dart-mtp, /arm-io/dockchannel-mtp). The
+		 * DART registers are at the start of dart-mtp reg 0 (PARAMS4 reads
+		 * 16 SIDs there), unlike t602x where the DART is 0x8000 in.
+		 */
+		mtp: mtp@514600000 {
+			compatible = "apple,t6041-mtp", "apple,t6041-rtk-helper-asc4",
+				     "apple,mtp", "apple,rtk-helper-asc4";
+			reg = <0x5 0x14600000 0x0 0x4000>,
+			      <0x5 0x14c00000 0x0 0x100000>;
+			reg-names = "asc", "sram";
+			mboxes = <&mtp_mbox>;
+			iommus = <&mtp_dart 1 0x100 0x0 0x1 0x0>;
+			#helper-cells = <0>;
+
+			status = "disabled";
+		};
+
+		mtp_mbox: mbox@514608000 {
+			compatible = "apple,t6041-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x5 0x14608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 792 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 793 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 794 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 795 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+
+			status = "disabled";
+		};
+
+		mtp_dart: iommu@514800000 {
+			compatible = "apple,t6041-dart", "apple,t8110-dart";
+			reg = <0x5 0x14800000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 775 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <5>;
+
+			status = "disabled";
+		};
+
+		mtp_dockchannel: fifo@514b14000 {
+			compatible = "apple,t6041-dockchannel", "apple,dockchannel";
+			reg = <0x5 0x14b14000 0x0 0x4000>;
+			reg-names = "irq";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 776 IRQ_TYPE_LEVEL_HIGH>;
+
+			ranges = <0 0x5 0x14b28000 0x20000>;
+			nonposted-mmio;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			interrupt-controller;
+			#interrupt-cells = <2>;
+
+			status = "disabled";
+
+			mtp_hid: input@8000 {
+				compatible = "apple,dockchannel-hid";
+				reg = <0x8000 0x4000>,
+				      <0xc000 0x4000>,
+				      <0x0000 0x4000>,
+				      <0x4000 0x4000>;
+				reg-names = "config", "data",
+					    "rmt-config", "rmt-data";
+				iommus = <&mtp_dart 1 0x100 0x0 0x1 0x0>;
+				interrupt-parent = <&mtp_dockchannel>;
+				interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
+					     <3 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "tx", "rx";
+
+				apple,fifo-size = <0x800>;
+				apple,helper-cpu = <&mtp>;
+			};
+		};
+
 		wdt: watchdog@50836c000 {
 			compatible = "apple,t6041-wdt", "apple,t8103-wdt";
 			reg = <0x5 0x0836c000 0x0 0x4000>;
-- 
