From 708438fc745a69e15512a11527ae88b84a79c04c Mon Sep 17 00:00:00 2001
From: nixos-m4pro <local@local>
Date: Thu, 12 Nov 2026 20:22:28 +0000
Subject: [PATCH 7/8] arm64: dts: apple: j614s/j616s: Enable the internal
 keyboard and trackpad

Enable MTP, its mailbox and DART, and the dockchannel HID interface, with
the keyboard alias m1n1 uses to fill in the layout. The SMC reset GPIOs
for the trackpad AFE and STM are left out until there is an SMC driver.
The trackpad needs apple/tpmtfw-j614s.bin from macOS.
---
 arch/arm64/boot/dts/apple/t6040-j614s.dts     |  4 ++
 .../arm64/boot/dts/apple/t604x-j614-j616.dtsi | 44 +++++++++++++++++++
 2 files changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6040-j614s.dts b/arch/arm64/boot/dts/apple/t6040-j614s.dts
index 3d3d28a90..ee2b70ac6 100644
--- a/arch/arm64/boot/dts/apple/t6040-j614s.dts
+++ b/arch/arm64/boot/dts/apple/t6040-j614s.dts
@@ -28,6 +28,10 @@ / {
 /delete-node/ &ps_dispext2_sys;
 #endif
 
+&mtp_mt {
+	firmware-name = "apple/tpmtfw-j614s.bin";
+};
+
 /*
  * Console for bring-up: the dockchannel UART FIFO, which the host reads over
  * debug USB. uart0 is not routed to the host on this machine. reg is the
diff --git a/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi b/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi
index a64797518..0cba2f80a 100644
--- a/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi
+++ b/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi
@@ -63,3 +63,47 @@ &fpwm0 {
 &serial0 {
 	status = "okay";
 };
+
+/ {
+	aliases {
+		keyboard = &keyboard;
+	};
+};
+
+&mtp {
+	status = "okay";
+};
+
+&mtp_mbox {
+	status = "okay";
+};
+
+&mtp_dart {
+	status = "okay";
+};
+
+&mtp_dockchannel {
+	status = "okay";
+};
+
+/*
+ * The MTP firmware may ask for the AFE and STM reset lines; they are SMC
+ * GPIOs (apple,afe-reset-gpios, apple,stm-reset-gpios on t602x) and are
+ * added with the SMC. The stm node is left out until then.
+ */
+&mtp_hid {
+	mtp_mt: multi-touch {
+	};
+
+	keyboard: keyboard {
+		/* Filled in by m1n1 from the ADT. */
+		hid-country-code = <0>;
+		apple,keyboard-layout-id = <0>;
+	};
+
+	actuator {
+	};
+
+	tp_accel {
+	};
+};
-- 
