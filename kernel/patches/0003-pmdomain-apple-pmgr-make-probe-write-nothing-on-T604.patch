From ae642c7e449a2bf214a8f782a8ca84bd4a034f73 Mon Sep 17 00:00:00 2001
From: nixos-m4pro <local@local>
Date: Thu, 12 Nov 2026 19:31:13 +0000
Subject: [PATCH 3/4] pmdomain: apple: pmgr: make probe write nothing on T6040
 (bring-up)

On the M4 Pro (J614s) the machine resets on its own a few minutes after
Linux starts: about 185 s with 12 cores, 250 s with one, with no kernel
message and the hardware watchdog off. With this driver blacklisted it
stays up past 440 s; with the I2C, SPMI, pinctrl, watchdog, UART and PWM
drivers blacklisted but this one loaded it still resets.

The domain list for T6040 is the M4 Max one (t6041-pmgr.dtsi) and is not
verified against this chip. On apple,t6040, leave the hardware as the
bootloader left it at probe: no auto-PM enable on active domains, no
apple,min-state write, and an always-on domain that is off stays off and
is not registered.
---
 drivers/pmdomain/apple/pmgr-pwrstate.c | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index a92db8cf8..4cebef602 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -237,6 +237,7 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 	int ret;
 	const char *name;
 	bool active;
+	bool t6040;
 
 	regmap = syscon_node_to_regmap(node->parent);
 	if (IS_ERR(regmap))
@@ -266,8 +267,15 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 	ps->genpd.power_on = apple_pmgr_ps_power_on;
 	ps->genpd.power_off = apple_pmgr_ps_power_off;
 
+	/*
+	 * T6040 (M4 Pro) bring-up: probe must not write the PMGR. Its domain
+	 * list is the unverified M4 Max one, and with these writes the machine
+	 * resets on its own about 3-4 minutes after boot.
+	 */
+	t6040 = of_machine_is_compatible("apple,t6040");
+
 	ret = of_property_read_u32(node, "apple,min-state", &ps->min_state);
-	if (ret == 0 && ps->min_state <= APPLE_PMGR_PS_ACTIVE)
+	if (ret == 0 && ps->min_state <= APPLE_PMGR_PS_ACTIVE && !t6040)
 		regmap_update_bits(regmap, ps->offset, APPLE_PMGR_FLAGS | APPLE_PMGR_PS_MIN,
 				   FIELD_PREP(APPLE_PMGR_PS_MIN, ps->min_state));
 
@@ -283,6 +291,10 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 	active = apple_pmgr_ps_is_active(ps);
 	if (of_property_read_bool(node, "apple,always-on")) {
 		ps->genpd.flags |= GENPD_FLAG_ALWAYS_ON;
+		if (!active && t6040) {
+			dev_warn(dev, "always-on domain %s is off at boot; leaving it off on t6040\n", name);
+			return -ENODEV;
+		}
 		if (!active) {
 			dev_warn(dev, "always-on domain %s is not on at boot\n", name);
 			/* Turn it on so pm_genpd_init does not fail */
@@ -292,8 +304,15 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 		ps->genpd.flags |= GENPD_FLAG_DEFER_OFF | GENPD_FLAG_ACTIVE_WAKEUP;
 	}
 
-	/* Turn on auto-PM if the domain is already on */
-	if (active)
+	/*
+	 * Turn on auto-PM if the domain is already on.
+	 *
+	 * Not on T6040 (M4 Pro) yet: its domain list comes from the M4 Max
+	 * tree and is unverified, and with auto-PM set on every active domain
+	 * the machine resets on its own a few minutes after boot (185 s with
+	 * 12 cores, 250 s with one). Without this driver it stays up.
+	 */
+	if (active && !of_machine_is_compatible("apple,t6040"))
 		regmap_update_bits(regmap, ps->offset, APPLE_PMGR_FLAGS | APPLE_PMGR_AUTO_ENABLE,
 				   APPLE_PMGR_AUTO_ENABLE);
 
