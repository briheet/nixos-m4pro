From c6b3daf63c3c66467b1fc71786620321cbb61b5f Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 05:18:45 +0000
Subject: [PATCH 17/21] arm64: dts: apple: t6041: Report ANS power to PMP

ANS is a notify_pmp device (entry 0x21). macOS reports its power state to
PMP; take the ANS mailbox, SART and NVMe power domain through a PMP report
entry, as t6031-nvme.dtsi does with APPLE_USE_PMP.
---
 arch/arm64/boot/dts/apple/t6041.dtsi | 28 +++++++++++++++++++++++++---
 1 file changed, 25 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
index ef6ef92da..5982a2b28 100644
--- a/arch/arm64/boot/dts/apple/t6041.dtsi
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -682,14 +682,14 @@ ans_mbox: mbox@409608000 {
 				     <AIC_IRQ 1533 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "send-empty", "send-not-empty",
 					  "recv-empty", "recv-not-empty";
-			power-domains = <&ps_ans>;
+			power-domains = <&pmp_report_ans>;
 			#mbox-cells = <0>;
 		};
 
 		sart: sart@40dc50000 {
 			compatible = "apple,t6041-sart", "apple,t6000-sart";
 			reg = <0x4 0x0dc50000 0x0 0xc000>;
-			power-domains = <&ps_ans>;
+			power-domains = <&pmp_report_ans>;
 		};
 
 		nvme: nvme@44dcc0000 {
@@ -701,7 +701,7 @@ nvme: nvme@44dcc0000 {
 			interrupts = <AIC_IRQ 2583 IRQ_TYPE_LEVEL_HIGH>;
 			mboxes = <&ans_mbox>;
 			apple,sart = <&sart>;
-			power-domains = <&ps_ans>, <&ps_apcie_sys_st0>,
+			power-domains = <&pmp_report_ans>, <&ps_apcie_sys_st0>,
 					<&ps_apcie_sys_st1>;
 			power-domain-names = "ans", "apcie0", "apcie1";
 			resets = <&ps_ans>;
@@ -725,6 +725,28 @@ pmp_dart: iommu@500300000 {
 			power-domains = <&ps_pmp>;
 		};
 
+		/*
+		 * PMP's device power-state report block: pmp reg 3 - 0x10000, as
+		 * m1n1's tools/pmp_assist.py derives it. Entries are the pmgr
+		 * device id - 1 of the ADT's notify_pmp devices (ANS: 0x21).
+		 */
+		pmp_report: pmp_report@5003c0000 {
+			compatible = "apple,t6041-pmp-v2-report";
+			reg = <0x5 0x003c0000 0x0 0x20000>;
+			power-domains = <&ps_pms_sram>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			pmp_report_ans: report@21 {
+				compatible = "apple,t6041-pmp-v2-report-entry",
+					     "apple,t6000-pmp-v2-report-entry";
+				reg = <0x21>;
+				label = "pmp-ans";
+				#power-domain-cells = <0>;
+				power-domains = <&ps_ans>;
+			};
+		};
+
 		pmp: pmp@500700000 {
 			compatible = "apple,t6041-pmp-v2", "apple,t6000-pmp-v2";
 			reg = <0x5 0x00700000 0x0 0xe0000>,
