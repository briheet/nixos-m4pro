From d019f3643597b9cc8fbf8faeb1264af7031250a1 Mon Sep 17 00:00:00 2001
From: nixos-m4pro <local@local>
Date: Thu, 12 Nov 2026 21:22:58 +0000
Subject: [PATCH 07/11] arm64: dts: apple: j614s: Keep ANS powered; follow
 Asahi on aic and pms_fpwm

Gating the ANS power domain resets the machine about 3 minutes later
(193 s on J614s, every time). Found by powering off, on the running
machine, each of the 63 domains Linux turns off at boot: only ans does
it. t8132-pmgr.dtsi marks ans always-on for the same reason.

Follow Asahi's curated t6041 list where it departs from the ADT's
critical flag: aic is always-on, and pms_fpwm0-4 are not (they sit at
state 0x4, the forced power-on at probe fails, and an SError follows).
The list is regenerated by nixos-m4pro pmgr-dtsi, which carries these
overrides.
---
 arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi b/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi
index 9a47a2775..b44970154 100644
--- a/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t6040-j614s-pmgr.dtsi
@@ -618,6 +618,7 @@ ps_ans: power-controller@370 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_fab3_soc>;
 		#reset-cells = <0>;
+		apple,always-on; /* the machine resets about 3 minutes after this is gated (193 s on J614s) */
 	};
 
 	ps_isp_sys: power-controller@378 {
@@ -773,6 +774,7 @@ ps_aic: power-controller@118 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_pms>;
 		#reset-cells = <0>;
+		apple,always-on; /* the interrupt controller; always-on in Asahi's t6041 list */
 	};
 
 	ps_pmc: power-controller@120 {
@@ -820,7 +822,6 @@ ps_pms_fpwm0: power-controller@140 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_pms>;
 		#reset-cells = <0>;
-		apple,always-on;
 	};
 
 	ps_pms_fpwm1: power-controller@148 {
@@ -830,7 +831,6 @@ ps_pms_fpwm1: power-controller@148 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_pms>;
 		#reset-cells = <0>;
-		apple,always-on;
 	};
 
 	ps_pms_fpwm2: power-controller@150 {
@@ -840,7 +840,6 @@ ps_pms_fpwm2: power-controller@150 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_pms>;
 		#reset-cells = <0>;
-		apple,always-on;
 	};
 
 	ps_pms_fpwm3: power-controller@158 {
@@ -850,7 +849,6 @@ ps_pms_fpwm3: power-controller@158 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_pms>;
 		#reset-cells = <0>;
-		apple,always-on;
 	};
 
 	ps_pms_fpwm4: power-controller@160 {
@@ -860,7 +858,6 @@ ps_pms_fpwm4: power-controller@160 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_pms>;
 		#reset-cells = <0>;
-		apple,always-on;
 	};
 
 	ps_fab0_soc: power-controller@168 {
