From 058e903ea60cc20307beb8e3e80f99f72ca25622 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Sat, 14 Nov 2026 08:56:42 +0000
Subject: [PATCH] soc: apple: rtkit-helper: Stop an adopted MTP at shutdown

An MTP session adopted from U-Boot (patch 0032) is never quiesced at
remove, and so it also ran through a reboot, its DART in bypass. iBoot
then panicked loading the boot object (3bdace14b1a9a68:2081) on 3 of 5
reboots, against none when Linux had started the MTP itself.

Quiesce an adopted session and stop the coprocessor's CPU at shutdown.
A session Linux started is left as it was.
---
 drivers/soc/apple/rtkit-helper.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/soc/apple/rtkit-helper.c b/drivers/soc/apple/rtkit-helper.c
index acacbb46d..384d80570 100644
--- a/drivers/soc/apple/rtkit-helper.c
+++ b/drivers/soc/apple/rtkit-helper.c
@@ -285,6 +285,24 @@ static void apple_rtkit_helper_remove(struct platform_device *pdev)
 	writel_relaxed(0, helper->asc_base + APPLE_ASC_CPU_CONTROL);
 }
 
+/*
+ * A session adopted from U-Boot is left running at remove, but not across
+ * a reboot: iBoot then found the MTP still running with its DART in bypass
+ * and on some boots panicked loading the boot object (3bdace14b1a9a68:2081).
+ * Put it to sleep and stop its CPU, as a session Linux started is not.
+ */
+static void apple_rtkit_helper_shutdown(struct platform_device *pdev)
+{
+	struct apple_rtkit_helper *helper = platform_get_drvdata(pdev);
+
+	if (!helper || !helper->adopted || IS_ERR_OR_NULL(helper->rtk))
+		return;
+
+	if (apple_rtkit_is_running(helper->rtk) && apple_rtkit_quiesce(helper->rtk))
+		dev_warn(helper->dev, "MTP did not quiesce at shutdown\n");
+	writel_relaxed(0, helper->asc_base + APPLE_ASC_CPU_CONTROL);
+}
+
 static const struct of_device_id apple_rtkit_helper_of_match[] = {
 	{ .compatible = "apple,rtk-helper-asc4" },
 	{},
@@ -298,6 +316,7 @@ static struct platform_driver apple_rtkit_helper_driver = {
 	},
 	.probe = apple_rtkit_helper_probe,
 	.remove = apple_rtkit_helper_remove,
+	.shutdown = apple_rtkit_helper_shutdown,
 };
 module_platform_driver(apple_rtkit_helper_driver);
 
-- 
