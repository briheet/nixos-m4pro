From dd4623ee7d04535560c2de796b670b8664b1429d Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 04:34:57 +0000
Subject: [PATCH 14/21] soc: apple: rtkit: Serve buffer requests on system
 endpoint 7

The T6040 PMP starts system endpoint 7 and asks for a 2-page buffer there;
it does not acknowledge its IOP power state until it gets one, so the PMP
driver timed out. macOS 27.2.1 answers that request with message type 5
(traced under the m1n1 hypervisor); PMP ignores the type 1 used for the
other buffer endpoints. Start the endpoint and answer its buffer requests
with type 5.
---
 drivers/soc/apple/rtkit-internal.h |  1 +
 drivers/soc/apple/rtkit.c          | 30 ++++++++++++++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/drivers/soc/apple/rtkit-internal.h b/drivers/soc/apple/rtkit-internal.h
index c82065a8b..9580d54d0 100644
--- a/drivers/soc/apple/rtkit-internal.h
+++ b/drivers/soc/apple/rtkit-internal.h
@@ -44,6 +44,7 @@ struct apple_rtkit {
 
 	struct apple_rtkit_shmem ioreport_buffer;
 	struct apple_rtkit_shmem crashlog_buffer;
+	struct apple_rtkit_shmem sys7_buffer;
 	struct apple_rtkit_shmem oslog_buffer;
 
 	struct apple_rtkit_shmem syslog_buffer;
diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index a863ae166..0de8da945 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -21,6 +21,12 @@ enum {
 	APPLE_RTKIT_EP_SYSLOG = 2,
 	APPLE_RTKIT_EP_DEBUG = 3,
 	APPLE_RTKIT_EP_IOREPORT = 4,
+	/*
+	 * Seen on the T6040 PMP: asks for a buffer at boot and does not finish
+	 * booting (no IOP power ack) until it gets one, answered with message
+	 * type 5 (macOS 27.2.1 under the m1n1 hypervisor). Its use is unknown.
+	 */
+	APPLE_RTKIT_EP_SYS7 = 7,
 	APPLE_RTKIT_EP_OSLOG = 8,
 };
 
@@ -55,6 +61,7 @@ enum {
 #define APPLE_RTKIT_CRASHLOG_CRASH 1
 
 #define APPLE_RTKIT_BUFFER_REQUEST	1
+#define APPLE_RTKIT_SYS7_BUFFER_REPLY	5
 #define APPLE_RTKIT_BUFFER_REQUEST_SIZE GENMASK_ULL(51, 44)
 #define APPLE_RTKIT_BUFFER_REQUEST_IOVA GENMASK_ULL(43, 0)
 
@@ -190,6 +197,7 @@ static void apple_rtkit_management_rx_epmap(struct apple_rtkit *rtk, u64 msg)
 		case APPLE_RTKIT_EP_CRASHLOG:
 		case APPLE_RTKIT_EP_DEBUG:
 		case APPLE_RTKIT_EP_IOREPORT:
+		case APPLE_RTKIT_EP_SYS7:
 		case APPLE_RTKIT_EP_OSLOG:
 			dev_dbg(rtk->dev,
 				"RTKit: Starting system endpoint 0x%02x\n", ep);
@@ -306,7 +314,13 @@ static int apple_rtkit_common_rx_get_buffer(struct apple_rtkit *rtk,
 			reply |= FIELD_PREP(APPLE_RTKIT_OSLOG_IOVA,
 					    buffer->iova >> 12);
 		} else {
+			/*
+			 * Endpoint 7 takes its buffer with message type 5, as
+			 * macOS answers the T6040 PMP; it ignores type 1.
+			 */
 			reply = FIELD_PREP(APPLE_RTKIT_SYSLOG_TYPE,
+					   ep == APPLE_RTKIT_EP_SYS7 ?
+					   APPLE_RTKIT_SYS7_BUFFER_REPLY :
 					   APPLE_RTKIT_BUFFER_REQUEST);
 			reply |= FIELD_PREP(APPLE_RTKIT_BUFFER_REQUEST_SIZE,
 					    buffer->size >> 12);
@@ -397,6 +411,17 @@ static void apple_rtkit_crashlog_rx(struct apple_rtkit *rtk, u64 msg)
 		rtk->ops->crashed(rtk->cookie, bfr, bfr ? rtk->crashlog_buffer.size : 0);
 }
 
+static void apple_rtkit_sys7_rx(struct apple_rtkit *rtk, u64 msg)
+{
+	u8 type = FIELD_GET(APPLE_RTKIT_SYSLOG_TYPE, msg);
+
+	if (type == APPLE_RTKIT_BUFFER_REQUEST)
+		apple_rtkit_common_rx_get_buffer(rtk, &rtk->sys7_buffer,
+						 APPLE_RTKIT_EP_SYS7, msg);
+	else
+		dev_warn(rtk->dev, "RTKit: Unknown EP7 message: %llx\n", msg);
+}
+
 static void apple_rtkit_ioreport_rx(struct apple_rtkit *rtk, u64 msg)
 {
 	u8 type = FIELD_GET(APPLE_RTKIT_SYSLOG_TYPE, msg);
@@ -542,6 +567,9 @@ static void apple_rtkit_rx_work(struct work_struct *work)
 	case APPLE_RTKIT_EP_IOREPORT:
 		apple_rtkit_ioreport_rx(rtk, rtk_work->msg);
 		break;
+	case APPLE_RTKIT_EP_SYS7:
+		apple_rtkit_sys7_rx(rtk, rtk_work->msg);
+		break;
 	case APPLE_RTKIT_EP_OSLOG:
 		apple_rtkit_oslog_rx(rtk, rtk_work->msg);
 		break;
@@ -741,6 +769,7 @@ int apple_rtkit_reinit(struct apple_rtkit *rtk)
 	flush_workqueue(rtk->wq);
 
 	apple_rtkit_free_buffer(rtk, &rtk->ioreport_buffer);
+	apple_rtkit_free_buffer(rtk, &rtk->sys7_buffer);
 	apple_rtkit_free_buffer(rtk, &rtk->crashlog_buffer);
 	apple_rtkit_free_buffer(rtk, &rtk->oslog_buffer);
 	apple_rtkit_free_buffer(rtk, &rtk->syslog_buffer);
@@ -945,6 +974,7 @@ void apple_rtkit_free(struct apple_rtkit *rtk)
 	destroy_workqueue(rtk->wq);
 
 	apple_rtkit_free_buffer(rtk, &rtk->ioreport_buffer);
+	apple_rtkit_free_buffer(rtk, &rtk->sys7_buffer);
 	apple_rtkit_free_buffer(rtk, &rtk->crashlog_buffer);
 	apple_rtkit_free_buffer(rtk, &rtk->oslog_buffer);
 	apple_rtkit_free_buffer(rtk, &rtk->syslog_buffer);
