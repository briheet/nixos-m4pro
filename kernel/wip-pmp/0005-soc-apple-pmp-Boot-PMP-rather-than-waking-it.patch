From 3ffe50592d646615a0b7bcb3d73dd9fb0058dc79 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 05:16:46 +0000
Subject: [PATCH 5/8] soc: apple: pmp: Boot PMP rather than waking it

The probe starts the PMP CPU, so wait for its boot. macOS sends no IOP power
request; the T6040 PMP never acknowledges one sent before its hello.
---
 drivers/soc/apple/pmp.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/pmp.rs b/drivers/soc/apple/pmp.rs
index a10c6766b..76c210c8d 100644
--- a/drivers/soc/apple/pmp.rs
+++ b/drivers/soc/apple/pmp.rs
@@ -146,7 +146,10 @@ fn new(dev: &platform::Device<Core<'_>>) -> Result<Arc<PmpData>> {
     fn start(&self) -> Result<()> {
         let mut guard = self.rtkit.lock();
         let mut rtk = guard.as_mut().as_pin_mut().unwrap();
-        rtk.as_mut().wake()?;
+        // PMP was just started (CPU run bit set in probe). Wait for its own
+        // boot instead of sending an IOP power request: macOS sends none,
+        // and the T6040 PMP never acknowledges one sent before its hello.
+        rtk.as_mut().boot()?;
         rtk.start_endpoint(PMP_ENDPOINT)
     }
     fn patch_bootargs(
