From 72d17b4d19b26b3c668c8db71d2a3bc181e8eda3 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 05:19:58 +0000
Subject: [PATCH 8/8] pmdomain: apple: pmp-report: Use a 64-bit shift for the
 entry bit

1 << id is an int shift, undefined for ids of 32 and up. T6041 reports ANS
as entry 0x21.
---
 drivers/pmdomain/apple/pmp-report.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 2380ea6c8..19abdbb81 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -132,7 +132,7 @@ static int apple_pmp_report_set_state(struct generic_pm_domain *genpd, bool enab
 {
 	struct apple_pmp_report_entry *ent = genpd_to_apple_pmp_report_entry(genpd);
 	struct apple_pmp_report *rep = dev_get_drvdata(ent->dev->parent);
-	u64 bit_val = 1 << ent->id;
+	u64 bit_val = BIT_ULL(ent->id);
 	u64 val;
 	unsigned long flags;
 
