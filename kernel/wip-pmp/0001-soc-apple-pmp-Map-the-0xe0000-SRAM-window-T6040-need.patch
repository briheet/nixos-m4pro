From 5ae5c6b7fd1099da598b8b55e3445ecb0fd2bd35 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 04:24:22 +0000
Subject: [PATCH 1/3] soc: apple: pmp: Map the 0xe0000 SRAM window T6040 needs

The T6040 PMP firmware keeps its bootargs at 0x87480 in its SRAM, past the
0x80000 window that covers T6030. The J614s ADT gives the region as 0xe0000.
---
 drivers/soc/apple/pmp.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/pmp.rs b/drivers/soc/apple/pmp.rs
index 7924881a2..a10c6766b 100644
--- a/drivers/soc/apple/pmp.rs
+++ b/drivers/soc/apple/pmp.rs
@@ -48,7 +48,9 @@
     types::ForeignOwnable, //
 };
 
-const PMP_MMIO_SIZE: usize = 0x80000;
+// The PMP SRAM window. T6040 (M4 Pro) keeps the bootargs at 0x87480, past
+// the 0x80000 that covers T6030; its ADT gives the region as 0xe0000.
+const PMP_MMIO_SIZE: usize = 0xe0000;
 const ASC_MMIO_SIZE: usize = 0x4000;
 const BOOTARGS_OFFSET: usize = 0x22c;
 const BOOTARGS_SIZE: usize = 0x230;
