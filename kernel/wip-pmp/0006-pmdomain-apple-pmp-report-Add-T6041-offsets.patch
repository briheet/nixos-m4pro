From 10085345ceca8f956f543ec8a4fc438916099208 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 05:18:45 +0000
Subject: [PATCH 6/8] pmdomain: apple: pmp-report: Add T6041 offsets

From the J614s ADT pmp ptd-range (m1n1 tools/pmp_assist.py), matching the
writes macOS 27.2.1 makes under the m1n1 hypervisor.
---
 drivers/pmdomain/apple/pmp-report.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 39a10a0b6..2380ea6c8 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -75,6 +75,18 @@ static const struct apple_pmp_report_offsets apple_pmp_offsets_t6030 = {
 	.status = 0x10,
 };
 
+/*
+ * T6040/T6041 (M4 Pro/Max): from the J614s ADT's pmp ptd-range, as computed by
+ * m1n1's tools/pmp_assist.py, and matching the DEV_STATUS_TGT_WR writes
+ * macOS 27.2.1 makes under the m1n1 hypervisor.
+ */
+static const struct apple_pmp_report_offsets apple_pmp_offsets_t6041 = {
+	.tgt_read = 0x1e00,
+	.tgt_write = 0x10f00,
+	.actual = 0x1e80,
+	.status = 0x10,
+};
+
 static const struct apple_pmp_report_offsets apple_pmp_offsets_t8112 = {
 	.tgt_read = 0xa00,
 	.tgt_write = 0x10500,
@@ -93,6 +105,7 @@ static const struct of_device_id apple_pmp_report_of_match[] = {
 	{ .compatible = "apple,t6000-pmp-v2-report", .data = &apple_pmp_offsets_t600x },
 	{ .compatible = "apple,t6020-pmp-v2-report", .data = &apple_pmp_offsets_t602x },
 	{ .compatible = "apple,t6030-pmp-v2-report", .data = &apple_pmp_offsets_t6030 },
+	{ .compatible = "apple,t6041-pmp-v2-report", .data = &apple_pmp_offsets_t6041 },
 	{ .compatible = "apple,t8112-pmp-v2-report", .data = &apple_pmp_offsets_t8112 },
 	{ .compatible = "apple,t8122-pmp-v2-report", .data = &apple_pmp_offsets_t8122 },
 	{}
