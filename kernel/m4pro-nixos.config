# What NixOS and systemd need, on top of m4pro-min.config. The drivers stay
# built in; module support is on because NixOS builds its module tree
# (lib/modules/<version>, depmod) from the kernel package.
#   kernel/m4pro-nixos.full.config: these options on top of m4pro-min.config,
#   completed by make olddefconfig (scripts/config --enable X, then olddefconfig)
CONFIG_LOCALVERSION="-m4pro-nixos"
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# systemd (see systemd's README "REQUIREMENTS")
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_PROC_CHILDREN=y
CONFIG_SYSFS_SYSCALL=n
CONFIG_UEVENT_HELPER=n
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_SCHED_AUTOGROUP=y
CONFIG_KCMP=y
CONFIG_RSEQ=y
CONFIG_MEMBARRIER=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_POSIX_TIMERS=y
CONFIG_TIMERFD=y
CONFIG_CROSS_MEMORY_ATTACH=y

# Filesystems NixOS uses for its root in RAM and later on disk. SQUASHFS sits
# under MISC_FILESYSTEMS and the loop device under BLK_DEV, which allnoconfig
# leaves off.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_BLK_DEV=y
CONFIG_SQUASHFS=y
# NixOS mounts its store image with threads=multi (kernels >= 6.2), which
# only exists with the decompressor chosen at mount time.
CONFIG_SQUASHFS_CHOICE_DECOMP_BY_MOUNT=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI=y
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXPORTFS=y

# Networking basics for systemd-networkd and friends.
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y

# Crypto systemd and nix use.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# Console niceties.
CONFIG_INPUT_MOUSEDEV=y
CONFIG_KEYBOARD_ATKBD=n
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y

# PMP, the power-management coprocessor. iBoot loads it but does not start
# it; the OS does, and macOS reports device power (ANS) to it. Asahi's PMP
# driver is Rust. docs/boot_linux/pmp.md
CONFIG_RUST=y
CONFIG_APPLE_PMP=y
