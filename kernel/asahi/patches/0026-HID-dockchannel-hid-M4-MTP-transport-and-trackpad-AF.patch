From 4cfcfbae3ccc5d8362c9afaa57f1f6bc7bacea1e Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 11:31:09 +0000
Subject: [PATCH 26/26] HID: dockchannel-hid: M4 MTP transport and trackpad AFE
 power (J614s)

The M4 Pro MTP firmware (macOS 26) takes the newer transport: a receive
ring and the second power command set, and powers the trackpad analog front
end through SMC key gp1c (the J614s ADT multi-touch function-afe-reset:
SMC function pKW4, gp1c, 0x10000). The older transport made the MTP reject
the interface reset (kIOReturnBadArgument).

The driver is aurora-silicon/linux integration/aurora drivers/hid/
dockchannel-hid (commits 94a3109ac361, d8b19e08abae, de1ddd1aa35a,
00768a757b56 and the ones before them; authors in their history), with:
- dockchannel_init_wakeup() from their dockchannel.c,
- apple_rtkit_helper_preserves_input(), always false here: this boot
  chain never hands the helper over running,
- the J614s nodes: the t6041 compatible, apple,afe-smc, and the interface
  names the firmware announces (tp-accel, mtp).
---
 arch/arm64/boot/dts/apple/t6041.dtsi          |   7 +-
 .../arm64/boot/dts/apple/t604x-j614-j616.dtsi |  13 +-
 drivers/hid/dockchannel-hid/Kconfig           |  29 +-
 drivers/hid/dockchannel-hid/Makefile          |   1 +
 .../dockchannel-hid-parser-test.c             | 280 ++++++
 .../dockchannel-hid-protocol-test.c           |  81 ++
 .../dockchannel-hid-protocol.h                |  55 +
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 936 +++++++++++++++---
 drivers/soc/apple/dockchannel.c               |  15 +
 drivers/soc/apple/rtkit-helper.c              |  12 +
 include/linux/soc/apple/dockchannel.h         |   1 +
 include/linux/soc/apple/rtkit-helper.h        |  12 +
 12 files changed, 1313 insertions(+), 129 deletions(-)
 create mode 100644 drivers/hid/dockchannel-hid/dockchannel-hid-parser-test.c
 create mode 100644 drivers/hid/dockchannel-hid/dockchannel-hid-protocol-test.c
 create mode 100644 drivers/hid/dockchannel-hid/dockchannel-hid-protocol.h
 create mode 100644 include/linux/soc/apple/rtkit-helper.h

diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
index bce1a1d76..2ef64dbd7 100644
--- a/arch/arm64/boot/dts/apple/t6041.dtsi
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -651,7 +651,12 @@ mtp_dockchannel: fifo@514b14000 {
 			status = "disabled";
 
 			mtp_hid: input@8000 {
-				compatible = "apple,dockchannel-hid";
+				/*
+				 * The M4 MTP firmware (macOS 26) takes the newer
+				 * transport: a receive ring and the second power
+				 * command set (aurora-silicon dockchannel-hid).
+				 */
+				compatible = "apple,t6041-dockchannel-hid", "apple,dockchannel-hid";
 				reg = <0x8000 0x4000>,
 				      <0xc000 0x4000>,
 				      <0x0000 0x4000>,
diff --git a/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi b/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi
index 30afbfdc2..1ba4cac70 100644
--- a/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi
+++ b/arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi
@@ -87,11 +87,13 @@ &mtp_dockchannel {
 };
 
 /*
- * The MTP firmware may ask for the AFE and STM reset lines. They are SMC
- * GPIOs (apple,afe-reset-gpios, apple,stm-reset-gpios on t602x) and are
- * added with the SMC driver.
+ * The trackpad's analog front end is powered through SMC key gp1c (the ADT
+ * multi-touch node's function-afe-reset: SMC function pKW4, gp1c, 0x10000).
+ * Interface names are the ones the MTP firmware announces.
  */
 &mtp_hid {
+	apple,afe-smc = <&smc>;
+
 	mtp_mt: multi-touch {
 	};
 
@@ -107,6 +109,9 @@ stm {
 	actuator {
 	};
 
-	tp_accel {
+	tp-accel {
+	};
+
+	mtp {
 	};
 };
diff --git a/drivers/hid/dockchannel-hid/Kconfig b/drivers/hid/dockchannel-hid/Kconfig
index 254961ad1..53ddaaac9 100644
--- a/drivers/hid/dockchannel-hid/Kconfig
+++ b/drivers/hid/dockchannel-hid/Kconfig
@@ -4,10 +4,37 @@ menu "DockChannel HID support"
 
 config HID_DOCKCHANNEL
 	tristate "HID over DockChannel transport layer for Apple Silicon SoCs"
-	depends on APPLE_DOCKCHANNEL && INPUT && OF && HID
+	depends on APPLE_DOCKCHANNEL && APPLE_RTKIT_HELPER && INPUT && OF && HID
+	depends on MFD_MACSMC || !MFD_MACSMC
 	help
 	  Say Y here if you use an M2 or later Apple Silicon based laptop.
 	  The keyboard and touchpad are HID based devices connected via the
 	  proprietary DockChannel interface.
 
+	  The MTP coprocessor announces the keyboard and touchpad only when
+	  it boots, so the driver cannot be unbound and rebound, or built as
+	  a module and reloaded, without losing both until the next boot.
+
+config HID_DOCKCHANNEL_KUNIT_TEST
+	tristate "KUnit tests for the DockChannel HID protocol helpers" if !KUNIT_ALL_TESTS
+	depends on KUNIT && HID_DOCKCHANNEL
+	default KUNIT_ALL_TESTS
+	help
+	  Build the KUnit tests for the DockChannel HID protocol helpers,
+	  which check the encoding of the MTP power commands. They need no
+	  Apple hardware. For more information on KUnit and unit tests in
+	  general, refer to Documentation/dev-tools/kunit/.
+
+	  If unsure, say N.
+
+config HID_DOCKCHANNEL_PARSER_KUNIT_TEST
+	bool "KUnit tests for DockChannel HID message parsing" if !KUNIT_ALL_TESTS
+	depends on HID_DOCKCHANNEL && KUNIT=y
+	default KUNIT_ALL_TESTS
+	help
+	  Build tests that pass malformed MTP frames to the initialization,
+	  input-report and acknowledgment handlers. Cover short headers,
+	  oversized lengths, interface indices and acknowledgment identity.
+	  The tests run without a DockChannel or HID device.
+
 endmenu
