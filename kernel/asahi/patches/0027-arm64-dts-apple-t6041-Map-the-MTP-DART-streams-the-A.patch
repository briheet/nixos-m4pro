From bed63f89503db88c22afc0394ee69952d50ca3d8 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 12:07:39 +0000
Subject: [PATCH 27/27] arm64: dts: apple: t6041: Map the MTP DART streams the
 ADT gives

The ADT dart-mtp mapper is stream 0, and its remap property folds streams
1-3 onto stream 0; the window is vm-base 0x10000004000, vm-size
0xffff0000. The nodes mapped only stream 1, which went unnoticed while the
MTP did no DMA into our memory (its RTKit buffers are in its own SRAM and
the keyboard arrives through the FIFO). The trackpad firmware upload and
the M4 receive ring are DMA. The DART driver has no stream remapping, so
streams 0-3 all get the same tables.
---
 arch/arm64/boot/dts/apple/t6041.dtsi | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
index 2ef64dbd7..e63f6d1e1 100644
--- a/arch/arm64/boot/dts/apple/t6041.dtsi
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -602,7 +602,16 @@ mtp: mtp@514600000 {
 			      <0x5 0x14c00000 0x0 0x100000>;
 			reg-names = "asc", "sram";
 			mboxes = <&mtp_mbox>;
-			iommus = <&mtp_dart 1 0x100 0x0 0x1 0x0>;
+			/*
+			 * ADT dart-mtp: the MTP's mapper is stream 0 and "remap"
+			 * folds streams 1-3 onto it; vm-base 0x10000004000,
+			 * vm-size 0xffff0000. Without stream remapping in the
+			 * DART driver, all four streams get the same tables.
+			 */
+			iommus = <&mtp_dart 0 0x100 0x4000 0x0 0xffff0000>,
+				 <&mtp_dart 1 0x100 0x4000 0x0 0xffff0000>,
+				 <&mtp_dart 2 0x100 0x4000 0x0 0xffff0000>,
+				 <&mtp_dart 3 0x100 0x4000 0x0 0xffff0000>;
 			#helper-cells = <0>;
 
 			status = "disabled";
@@ -663,7 +672,11 @@ mtp_hid: input@8000 {
 				      <0x4000 0x4000>;
 				reg-names = "config", "data",
 					    "rmt-config", "rmt-data";
-				iommus = <&mtp_dart 1 0x100 0x0 0x1 0x0>;
+				/* The same streams and window as the MTP. */
+				iommus = <&mtp_dart 0 0x100 0x4000 0x0 0xffff0000>,
+					 <&mtp_dart 1 0x100 0x4000 0x0 0xffff0000>,
+					 <&mtp_dart 2 0x100 0x4000 0x0 0xffff0000>,
+					 <&mtp_dart 3 0x100 0x4000 0x0 0xffff0000>;
 				interrupt-parent = <&mtp_dockchannel>;
 				interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
 					     <3 IRQ_TYPE_LEVEL_HIGH>;
