diff --git a/arch/arm64/include/asm/apple-idle.h b/arch/arm64/include/asm/apple-idle.h
new file mode 100644
index 000000000..619882f65
--- /dev/null
+++ b/arch/arm64/include/asm/apple-idle.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ASM_APPLE_IDLE_H
+#define __ASM_APPLE_IDLE_H
+
+/* WFI that preserves x18-x30 on affected Apple cores. */
+void apple_cpu_wfi(void);
+
+#ifdef CONFIG_ARCH_APPLE
+/* Called from smp_prepare_boot_cpu(): before the boot CPU's first idle. */
+void apple_wfi_quirk_init(void);
+#else
+static inline void apple_wfi_quirk_init(void) { }
+#endif
+
+#endif
diff --git a/arch/arm64/include/asm/cputype.h b/arch/arm64/include/asm/cputype.h
index 1b9f0cda1..e7ba8c547 100644
--- a/arch/arm64/include/asm/cputype.h
+++ b/arch/arm64/include/asm/cputype.h
@@ -234,6 +234,8 @@
 #define MIDR_HISI_TSV110 MIDR_CPU_MODEL(ARM_CPU_IMP_HISI, HISI_CPU_PART_TSV110)
 #define MIDR_HISI_HIP09 MIDR_CPU_MODEL(ARM_CPU_IMP_HISI, HISI_CPU_PART_HIP09)
 #define MIDR_HISI_HIP12 MIDR_CPU_MODEL(ARM_CPU_IMP_HISI, HISI_CPU_PART_HIP12)
+/* The first M4 part number (Donan E); later Apple cores number upward. */
+#define APPLE_CPU_PART_M4_DONAN_E	0x052
 #define MIDR_APPLE_M1_ICESTORM MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_M1_ICESTORM)
 #define MIDR_APPLE_M1_FIRESTORM MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_M1_FIRESTORM)
 #define MIDR_APPLE_M1_ICESTORM_PRO MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_M1_ICESTORM_PRO)
@@ -336,4 +338,13 @@ static inline u32 __attribute_const__ read_cpuid_cachetype(void)
 }
 #endif /* __ASSEMBLER__ */
 
+#ifndef __ASSEMBLER__
+/* Apple part numbers from Donan onward identify the M4 and later generations. */
+static inline bool midr_is_apple_m4_or_later(u32 midr)
+{
+	return MIDR_IMPLEMENTOR(midr) == ARM_CPU_IMP_APPLE &&
+	       MIDR_PARTNUM(midr) >= APPLE_CPU_PART_M4_DONAN_E;
+}
+#endif /* __ASSEMBLER__ */
+
 #endif
