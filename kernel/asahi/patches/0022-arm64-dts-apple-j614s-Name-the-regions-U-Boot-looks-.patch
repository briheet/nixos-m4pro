From 527a300feca71b29df216690e7a118113597f561 Mon Sep 17 00:00:00 2001
From: briheet-invideo <dev@localhost>
Date: Fri, 13 Nov 2026 08:24:13 +0000
Subject: [PATCH 22/23] arm64: dts: apple: j614s: Name the regions U-Boot looks
 up

Name the dockchannel UART reg "data" and add the NVMe "nvmmu" window
(ADT reg 3), which aurora-silicon U-Boot uses on T6040. Linux looks up its
regions by name and is unaffected.
---
 arch/arm64/boot/dts/apple/t6040-j614s.dts |  2 ++
 arch/arm64/boot/dts/apple/t6041.dtsi      | 10 ++++++++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6040-j614s.dts b/arch/arm64/boot/dts/apple/t6040-j614s.dts
index ee2b70ac6..7a16a5716 100644
--- a/arch/arm64/boot/dts/apple/t6040-j614s.dts
+++ b/arch/arm64/boot/dts/apple/t6040-j614s.dts
@@ -51,6 +51,8 @@ chosen {
 	dockchannel_uart: serial@50882c000 {
 		compatible = "apple,dockchannel-uart";
 		reg = <0x5 0x0882c000 0x0 0x4000>;
+		/* The data window itself (U-Boot's driver tells it from the config window by name). */
+		reg-names = "data";
 		status = "okay";
 	};
 };
diff --git a/arch/arm64/boot/dts/apple/t6041.dtsi b/arch/arm64/boot/dts/apple/t6041.dtsi
index b6a42541c..7b6a56a5b 100644
--- a/arch/arm64/boot/dts/apple/t6041.dtsi
+++ b/arch/arm64/boot/dts/apple/t6041.dtsi
@@ -695,8 +695,14 @@ sart: sart@40dc50000 {
 		nvme: nvme@44dcc0000 {
 			compatible = "apple,t6041-nvme-ans2", "apple,t8132-nvme-ans2";
 			reg = <0x4 0x4dcc0000 0x0 0x40000>,
-			      <0x4 0x09600000 0x0 0x4000>;
-			reg-names = "nvme", "ans";
+			      <0x4 0x09600000 0x0 0x4000>,
+			      <0x4 0x0dcc0000 0x0 0x60000>;
+			/*
+			 * nvmmu is ADT reg 3, the window U-Boot (aurora-silicon)
+			 * uses for the NVMMU and linear queue registers on T6040;
+			 * Linux reaches them through "nvme".
+			 */
+			reg-names = "nvme", "ans", "nvmmu";
 			interrupt-parent = <&aic>;
 			interrupts = <AIC_IRQ 2583 IRQ_TYPE_LEVEL_HIGH>;
 			mboxes = <&ans_mbox>;
-- 
