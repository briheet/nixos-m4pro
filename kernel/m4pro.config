# Fragment on top of arm64 defconfig for the first boot on J614s.
# Everything is built in: there are no modules and no root filesystem yet.
CONFIG_LOCALVERSION="-m4pro"
CONFIG_MODULES=n
CONFIG_RUST=n

# Apple Silicon uses 16K pages.
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARCH_APPLE=y

# Interrupts, console, watchdog, power domains, pins, I2C, SPMI.
CONFIG_APPLE_AIC=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_I2C_APPLE=y
CONFIG_SPMI_APPLE=y

# initramfs root.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# m1n1's framebuffer as simple-framebuffer, with a console on it.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Debugging the first boots.
CONFIG_PRINTK_TIME=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y

# Console the host can see: dockchannel over debug USB (ttyDC0).
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
